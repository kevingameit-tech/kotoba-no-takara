# Normalize line endings: LF in the repo and in every checkout (Windows too).
* text=auto eol=lf

# Binary files: no line ending conversion, no text diff.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
